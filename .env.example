# .env.example — project-epi (Dashboard Lapangan)
# JANGAN isi nilai asli di sini — ini hanya daftar env yang dibutuhkan + deskripsi. Salin ke .env lokal dan isi nilai sungguhan.

# --- Directus Backend (Single Source of Truth) ---
DIRECTUS_API_URL=
DIRECTUS_TOKEN=
# Cadangan untuk kompatibilitas client-build bila dibutuhkan
VITE_DIRECTUS_API_URL=
VITE_DIRECTUS_TOKEN=

# --- Firebase Client SDK (Autentikasi Pengguna) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Kiosk: sesi & badge (kioskAuth.ts) ---
# WAJIB di produksi, minimal 32 karakter acak. Kosong di produksi = 503 "Kiosk belum dikonfigurasi dengan benar".
KIOSK_SESSION_SECRET=
# WAJIB SAMA PERSIS antara project-epi dan erp-epi — dipakai menghitung DAN memverifikasi
# token QR kartu badge & Dynamic Screen QR meja.
WORKSTATION_HMAC_SECRET=

# --- Verifikasi Keaslian Dokumen & Sertifikat lewat QR ---
# SENSITIF. WAJIB SAMA PERSIS dengan DOKUMEN_VERIFIKASI_HMAC_SECRET di erp-epi (yang menandatangani QR saat cetak).
DOKUMEN_VERIFIKASI_HMAC_SECRET=
# Basis URL halaman verifikasi pada QR (bawaan: origin aplikasi ini).
VERIFIKASI_BASE_URL=
# Verifikasi sertifikat pelatihan internal (WAJIB SAMA dengan erp-epi)
TRAINING_CERT_VERIFY_SECRET=
TRAINING_CERT_VERIFY_ORIGIN=
# Verifikasi dokumen HR / surat tugas
HR_DOC_VERIFY_SECRET=

# --- Jembatan ke ERP Admin (erp-epi-1) ---
# Base URL server admin (contoh dev: http://localhost:9390, prod: https://internal.eltamaprimaindo.com)
ERP_EPI1_BASE_URL=
# Shared secret untuk komunikasi otomatisasi produksi (konsumsi, QC, FG request)
PRODUCTION_AUTOMATION_SECRET=
# Dipakai relay notifikasi Andon & trigger otomatisasi server (WAJIB SAMA dengan erp-epi)
AUTOMATION_SERVER_SECRET=
# Tanda tangan HMAC proxy ERP -> /api/gerbang-sj/* (SENSITIF, WAJIB SAMA dengan erp-epi)
GERBANG_PROXY_SECRET=

# --- Keamanan Enkripsi Payroll Data Encryption Key (DEK) ---
# Passphrase untuk mendekripsi data payroll sensitif di lapangan jika berwenang
PAYROLL_DEK_PASSPHRASE=

# --- Layanan Tambahan (AI, Face Recognition, PDF) ---
OPENROUTER_API_KEY=
VITE_OPENROUTER_API_KEY=
FACE_SERVICE_URL=
GOTENBERG_URL=

# --- Webhook n8n (Notifikasi Otomatis & Alert) ---
N8N_WEBHOOK_URL=
N8N_INVENTORY_ALERT_WEBHOOK=
BACKCHARGE_N8N_WEBHOOK_URL=

# --- SvelteKit adapter-node & Lingkungan ---
# Batas ukuran body request untuk upload foto multi-parameter kiosk, QC, dan nota petty cash (mis. 15M atau 15728640)
BODY_SIZE_LIMIT=15M
PUBLIC_APP_ENV=production
PUBLIC_SENTRY_DSN=
SENTRY_DSN=
